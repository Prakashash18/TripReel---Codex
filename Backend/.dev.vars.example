# Copy to .dev.vars for local development only. Never commit real values.
OPENAI_API_KEY=replace-with-a-project-scoped-openai-key
OPENROUTER_API_KEY=replace-with-a-project-scoped-openrouter-key
TRIPREEL_AUTH_TOKEN=replace-with-at-least-32-random-bytes
APP_ATTEST_ROUTING_SECRET=replace-with-at-least-32-random-bytes-and-keep-it-stable

# Optional. Leave unset for the native app. If a browser client is required, use
# exactly one HTTPS origin (localhost HTTP is accepted for local development).
# ALLOWED_ORIGIN=https://app.example.com

# Optional; valid range is 5000..45000. Default is 30000.
# OPENAI_TIMEOUT_MS=30000

# Optional. Must support image input and strict Structured Outputs.
# OPENAI_MODEL=gpt-5.6-luna
